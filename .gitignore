# ---------------------------------------------------------------------------
# ComfyHub
# ---------------------------------------------------------------------------

# 老 MySQL 便携版的二进制 / 实例目录（体积大且是机器相关数据）。
# ⚠ MySQL 已于 2026-09-29 彻底退役（脚本、清单、搬迁通道一起删），**这三条是刻意保留的**：
# 老机器上可能还留着几百 MB 的旧目录/旧指针，删掉 ignore 会让它们当场涌进 git status。
# 新装的机器上这三个都不会再出现。
/mysql/
/.mysql/
/.mysql-location.json

# SQLite 运行库（P2 起的默认库）：comfyhub.db 与它的 -wal / -shm 一起，属于运行期数据
# ⚠ 上面两条是**根锚定**的，所以 crate 目录里偶尔冒出来的同名残留要单独 ignore
# （2026-09-30：`server-rs\.db` / `server-rs\.run` 是历史现场留下的，真源永远在 <根>\.db / <根>\.run，
#   见 AGENTS §13；不 ignore 的话它们会一直挂在 git status 里，让人以为"库有两份"）
/.db/
/server-rs/.db/

# 运行期产物：后端日志、PID、临时启动脚本
/.run/
/server-rs/.run/

# 用户上传的生成产物原始文件
/storage/

# 演示用媒体（可由 scripts/make-sample-media.ps1 重新生成）
/samples/

# Kotlin 后端构建产物（`/server` 那条是老布局的残留规则，留着免得老机器上又冒出来）
/server/build/
/server/.gradle/
/server/storage/
# ⚠ `legacy/`（退役的 Kotlin 后端）**2026-09-30 已整个删除** —— 用户要求精简，
#   要回退旧后端从 git 历史取：`git show 6a9f243^:legacy/server/...`。所以这里不再有它的规则。

# ComfyUI 捕获扩展：本机配置（从 config.example.json 复制而来，地址每台机器不同）
/comfyui/comfyhub_capture/config.json

# Python 编译缓存（捕获扩展与 e2e 自测脚本会产生）
__pycache__/

# 临时跑批 / 调试产物（日志、比对图、抽帧、一次性脚本）
/_run/

# Kotlin 增量编译缓存
/server/.kotlin/
# Android 构建留下的 Kotlin 诊断日志（`android\.kotlin\errors\*.log`）——
# 跑一次 `:harness:testDebugUnitTest` 就会冒出来，不该进版本库
/android/.kotlin/

# 发布包装配输出（scripts\pack-release.ps1 的产物，几百 MB，不进版本库）
/dist/

# 自动下载的 Java 运行时（scripts\ensure-runtime.ps1 装到 <根>\jre，约 200MB）
/jre/


# 本机用 anima 跑批留下的任务文件（不属于工程产物）
/comfyui/anima_jobs/

# 本机跑图产物（flux3 输出 / 一次性 krea2 任务），不属于工程产物
/comfyui/flux3_out/
/comfyui/krea2_r2i_run*.json

# 角色卡资料草稿（本机整理用，未定稿不入库）
/docs/character-cards/

# Rust（server-rs）构建产物：621MB，绝不进版本库
/server-rs/target/


# 文案审校工具留下的临时备份（不入库）
*.copyreview-bak

# 本机素材（e2e 的参考照片，6.5MB）：脚本没给 -RefPhoto 时会退回画廊最新产物，别入库
/ref_photos/
