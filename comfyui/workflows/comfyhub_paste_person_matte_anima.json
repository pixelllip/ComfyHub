{
  "1": {
    "_meta": {
      "title": "底模 anima-base-v1.0"
    },
    "inputs": {
      "unet_name": "anima-base-v1.0.safetensors",
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader"
  },
  "2": {
    "_meta": {
      "title": "Sage Attention（KJ）"
    },
    "inputs": {
      "model": [
        "1",
        0
      ],
      "sage_attention": "auto",
      "allow_compile": false
    },
    "class_type": "PathchSageAttentionKJ"
  },
  "3": {
    "_meta": {
      "title": "加速 LoRA（anima-turbo-lora-v0.2，非画风；10 步 cfg1 靠它）"
    },
    "inputs": {
      "model": [
        "2",
        0
      ],
      "clip": [
        "5",
        0
      ],
      "lora_name": "anima-turbo-lora-v0.2.safetensors",
      "strength_model": 1.0,
      "strength_clip": 1.0
    },
    "class_type": "LoraLoader"
  },
  "4": {
    "_meta": {
      "title": "可选：画风 / 角色 LoRA（默认强度 0 = 不生效。要用就覆盖 lora_name 与 strength_model / strength_clip）"
    },
    "inputs": {
      "model": [
        "3",
        0
      ],
      "clip": [
        "3",
        1
      ],
      "lora_name": "anima-turbo-lora-v0.2.safetensors",
      "strength_model": 0.0,
      "strength_clip": 0.0
    },
    "class_type": "LoraLoader"
  },
  "5": {
    "_meta": {
      "title": "外挂 CLIP（qwen3-0.6B）"
    },
    "inputs": {
      "clip_name": "qwen_3_06b_base.safetensors",
      "type": "qwen_image",
      "device": "default"
    },
    "class_type": "CLIPLoader"
  },
  "6": {
    "_meta": {
      "title": "外挂 VAE"
    },
    "inputs": {
      "vae_name": "qwen_image_vae.safetensors"
    },
    "class_type": "VAELoader"
  },
  "10": {
    "_meta": {
      "title": "底图（要保留的那张）"
    },
    "inputs": {
      "image": "example.png"
    },
    "class_type": "LoadImage"
  },
  "11": {
    "_meta": {
      "title": "底图缩放到画布尺寸（必须与人物图/遮罩一致）"
    },
    "inputs": {
      "image": [
        "10",
        0
      ],
      "upscale_method": "area",
      "width": 896,
      "height": 1152,
      "crop": "disabled"
    },
    "class_type": "ImageScale"
  },
  "20": {
    "_meta": {
      "title": "人物图（阶段一产物：**纯色背景**那张。抠图靠它自己的 alpha）"
    },
    "inputs": {
      "image": "example.png"
    },
    "class_type": "LoadImage"
  },
  "21": {
    "_meta": {
      "title": "人物图缩放到画布尺寸（**抠图在缩放之后**，所以 alpha 与画布严格同尺寸）"
    },
    "inputs": {
      "image": [
        "20",
        0
      ],
      "upscale_method": "area",
      "width": 896,
      "height": 1152,
      "crop": "disabled"
    },
    "class_type": "ImageScale"
  },
  "27": {
    "_meta": {
      "title": "★ AI 抠图（软遮罩）：easy imageRemBg。rem_mode 可选 RMBG-2.0 / RMBG-1.4 / Inspyrenet / BEN2 —— 本机已在盘上的是 **BEN2**（1.1GB，质量最好）与 **RMBG-1.4**（169MB，快一个数量级）。⚠ 模型文件不在时会**静默去 HuggingFace 下载**，所以先查 ComfyUI\\models\\rembg\\ 再跑；缺了就按 skill 里的指引让用户下。image_output=Hide 是为了不往 output 落盘"
    },
    "inputs": {
      "images": [
        "21",
        0
      ],
      "rem_mode": "BEN2",
      "image_output": "Hide",
      "save_prefix": "comfyhub_matte",
      "torchscript_jit": false,
      "add_background": "none",
      "refine_foreground": false
    },
    "class_type": "easy imageRemBg"
  },
  "22": {
    "_meta": {
      "title": "按**软遮罩**把人物图贴到底图上（ImageCompositeMasked 是 alpha 混合：source*mask + dest*(1-mask)，所以这里的连续 alpha 真的会用上）。⚠ 源图是纯色背景那张，边界像素带着背景色 —— 想要彻底干净要靠 Rust 侧的去溢色/反混（comfy_make_mask matteSource=model），否则会留一层很淡的背景色"
    },
    "inputs": {
      "destination": [
        "11",
        0
      ],
      "source": [
        "21",
        0
      ],
      "x": 0,
      "y": 0,
      "resize_source": false,
      "mask": [
        "27",
        1
      ]
    },
    "class_type": "ImageCompositeMasked"
  },
  "23": {
    "_meta": {
      "title": "VAE 编码"
    },
    "inputs": {
      "pixels": [
        "22",
        0
      ],
      "vae": [
        "6",
        0
      ]
    },
    "class_type": "VAEEncode"
  },
  "28": {
    "_meta": {
      "title": "把软遮罩往外长 N 像素（ring 的外圈半径）"
    },
    "inputs": {
      "mask": [
        "27",
        1
      ],
      "expand": 14,
      "tapered_corners": false
    },
    "class_type": "GrowMask"
  },
  "29": {
    "_meta": {
      "title": "重绘区 = 长出来的那圈 **减去**软遮罩本身（MaskComposite.subtract = destination - source）→ 只圈人物**外面** N 像素 + 那条软边。于是人物 α=1 的内部一个像素都不会被重采样（画风原样），只有接缝被融"
    },
    "inputs": {
      "destination": [
        "28",
        0
      ],
      "source": [
        "27",
        1
      ],
      "x": 0,
      "y": 0,
      "operation": "subtract"
    },
    "class_type": "MaskComposite"
  },
  "24": {
    "_meta": {
      "title": "只给**人物外面那一圈**加噪（非遮罩区原样保留）"
    },
    "inputs": {
      "samples": [
        "23",
        0
      ],
      "mask": [
        "29",
        0
      ]
    },
    "class_type": "SetLatentNoiseMask"
  },
  "15": {
    "_meta": {
      "title": "正面提示词（只写**重绘区（人物外面那一圈）**里该出现什么 —— 要写**背景**，绝不能写人物，否则会在人周围又画一圈人/衣服）"
    },
    "inputs": {
      "clip": [
        "4",
        1
      ],
      "text": "night city square, wet asphalt, grass, buildings, street lights, no humans"
    },
    "class_type": "CLIPTextEncode"
  },
  "16": {
    "_meta": {
      "title": "负面提示词"
    },
    "inputs": {
      "clip": [
        "4",
        1
      ],
      "text": "worst quality, low quality, blurry, jpeg artifacts, bad anatomy, bad hands, extra digits, watermark, signature, text"
    },
    "class_type": "CLIPTextEncode"
  },
  "17": {
    "_meta": {
      "title": "K采样器（denoise=0 = 纯合成一个像素都不改；0.3~0.45 = 只融接缝（推荐）；1.0 = 那一圈整块重画）"
    },
    "inputs": {
      "model": [
        "4",
        0
      ],
      "seed": 20260927,
      "steps": 12,
      "cfg": 1.0,
      "sampler_name": "er_sde",
      "scheduler": "simple",
      "positive": [
        "15",
        0
      ],
      "negative": [
        "16",
        0
      ],
      "latent_image": [
        "24",
        0
      ],
      "denoise": 0.4
    },
    "class_type": "KSampler"
  },
  "18": {
    "_meta": {
      "title": "VAE 解码"
    },
    "inputs": {
      "samples": [
        "17",
        0
      ],
      "vae": [
        "6",
        0
      ]
    },
    "class_type": "VAEDecode"
  },
  "19": {
    "_meta": {
      "title": "保存图像（换 seed 抽卡，别换前缀）"
    },
    "inputs": {
      "images": [
        "18",
        0
      ],
      "filename_prefix": "comfyhub_inpaint_anima"
    },
    "class_type": "SaveImage"
  }
}
