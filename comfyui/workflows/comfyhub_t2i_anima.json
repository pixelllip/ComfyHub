{
  "1": {"_meta": {"title": "底模 anima-base-v1.0（与 inpaint 那份同一套加载器，保证两阶段画风一致）"}, "inputs": {"unet_name": "anima-base-v1.0.safetensors", "weight_dtype": "default"}, "class_type": "UNETLoader"},
  "2": {"_meta": {"title": "Sage Attention（KJ）"}, "inputs": {"model": ["1", 0], "sage_attention": "auto", "allow_compile": false}, "class_type": "PathchSageAttentionKJ"},
  "3": {"_meta": {"title": "加速 LoRA（anima-turbo-lora-v0.2；10~12 步 cfg1 靠它）"}, "inputs": {"model": ["2", 0], "clip": ["5", 0], "lora_name": "anima-turbo-lora-v0.2.safetensors", "strength_model": 1.0, "strength_clip": 1.0}, "class_type": "LoraLoader"},
  "4": {"_meta": {"title": "可选：画风 / 角色 LoRA（默认强度 0 = 不生效。要用就覆盖 lora_name 与 strength_model / strength_clip）"}, "inputs": {"model": ["3", 0], "clip": ["3", 1], "lora_name": "anima-turbo-lora-v0.2.safetensors", "strength_model": 0.0, "strength_clip": 0.0}, "class_type": "LoraLoader"},
  "5": {"_meta": {"title": "外挂 CLIP（qwen3-0.6B）"}, "inputs": {"clip_name": "qwen_3_06b_base.safetensors", "type": "qwen_image", "device": "default"}, "class_type": "CLIPLoader"},
  "6": {"_meta": {"title": "外挂 VAE"}, "inputs": {"vae_name": "qwen_image_vae.safetensors"}, "class_type": "VAELoader"},
  "10": {"_meta": {"title": "画布（要覆盖的键：10.width / 10.height；长宽比最好与最终那张底图一致）"}, "inputs": {"width": 768, "height": 1024, "batch_size": 1}, "class_type": "EmptyLatentImage"},
  "11": {"_meta": {"title": "正面提示词（Anima 是 Danbooru tag 模型：写角色前先按系统提示第 18 条查三处 —— 自己的库 / 角色卡 / danbooru）"}, "inputs": {"clip": ["4", 1], "text": "masterpiece, best quality, newest, 1girl, solo, looking at viewer, upper body"}, "class_type": "CLIPTextEncode"},
  "12": {"_meta": {"title": "负面提示词（cfg=1 时作用很弱：要排除某元素就写进正面）"}, "inputs": {"clip": ["4", 1], "text": "worst quality, low quality, blurry, jpeg artifacts, bad anatomy, bad hands, extra digits, watermark, signature, text"}, "class_type": "CLIPTextEncode"},
  "13": {"_meta": {"title": "K采样器（覆盖 13.seed 抽卡；10~12 步 / cfg 1.0 是 Turbo 档的常规跑法）"}, "inputs": {"model": ["4", 0], "seed": 20260926, "steps": 12, "cfg": 1.0, "sampler_name": "er_sde", "scheduler": "simple", "positive": ["11", 0], "negative": ["12", 0], "latent_image": ["10", 0], "denoise": 1.0}, "class_type": "KSampler"},
  "14": {"_meta": {"title": "VAE 解码"}, "inputs": {"samples": ["13", 0], "vae": ["6", 0]}, "class_type": "VAEDecode"},
  "15": {"_meta": {"title": "保存图像（**别换前缀**：两阶段的第一阶段产物就靠它入库）"}, "inputs": {"images": ["14", 0], "filename_prefix": "comfyhub_t2i_anima"}, "class_type": "SaveImage"}
}
