{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "fixture-inpaint.safetensors" }
  },
  "2": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "fixture-vae.safetensors" }
  },
  "3": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": { "model": ["1", 0], "lora_name": "fixture-lora.safetensors", "strength_model": 1.0 }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": { "clip": ["1", 1], "text": "a cat sitting on a chair" }
  },
  "5": {
    "class_type": "LoadImageMask",
    "inputs": { "image": "fixture-mask.png", "channel": "red" }
  },
  "6": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["3", 0],
      "positive": ["4", 0],
      "negative": ["4", 0],
      "latent_image": ["8", 0],
      "seed": 42,
      "steps": 20,
      "cfg": 7.0,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 1.0
    }
  },
  "7": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": 512, "height": 512, "batch_size": 1 }
  },
  "8": {
    "class_type": "SetLatentNoiseMask",
    "inputs": { "samples": ["7", 0], "mask": ["5", 0] }
  },
  "9": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["6", 0], "vae": ["2", 0] }
  },
  "10": {
    "class_type": "SaveImage",
    "inputs": { "images": ["9", 0], "filename_prefix": "e2e-recipe" }
  }
}
